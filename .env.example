# Copy to .env and change the values. Never commit .env.

# Any characters work, but avoid "$" (Docker Compose treats it as a variable) and quotes.
POSTGRES_PASSWORD=change-me-to-a-long-random-value

# Timezone of your syslog timestamps (they carry none), e.g. Europe/Rome.
MINISIEM_LOG_TZ=UTC

# Host port for the dashboard (http://127.0.0.1:<port>). Change it if 8000 is already in use
# or reserved by the OS (on Windows: "forbidden by its access permissions").
MINISIEM_PORT=8000

# Optional: if set, POST /ingest requires "Authorization: Bearer <token>".
MINISIEM_API_TOKEN=

# Optional: if set, the dashboard and GET /api/* ask for this token.
MINISIEM_READ_TOKEN=

# Optional: delete events and alerts older than this many days (0 keeps everything).
# The age is the time written in the log, not the time it was imported.
MINISIEM_RETENTION_DAYS=0

# --- Notifications (all optional; with no channel set nothing is sent) --------------------
# Test them with:  docker compose exec app minisiem notify-test
# Only alerts of at least this severity are sent: low | medium | high | critical
MINISIEM_NOTIFY_MIN_SEVERITY=high

# Telegram: create a bot with @BotFather, send it a message, then read your chat id.
MINISIEM_TELEGRAM_TOKEN=
MINISIEM_TELEGRAM_CHAT_ID=

# Webhook (Slack, Mattermost, Discord, your own service). Format: json | discord
MINISIEM_WEBHOOK_URL=
MINISIEM_WEBHOOK_TOKEN=
MINISIEM_WEBHOOK_FORMAT=json

# Email. Security: starttls | ssl | none
MINISIEM_SMTP_HOST=
MINISIEM_SMTP_PORT=587
MINISIEM_SMTP_SECURITY=starttls
MINISIEM_SMTP_USER=
MINISIEM_SMTP_PASSWORD=
MINISIEM_SMTP_FROM=
MINISIEM_SMTP_TO=

# --- GeoIP (optional) --------------------------------------------------------------------
# Put a MaxMind GeoLite2 database in ./geoip and use the path inside the container.
MINISIEM_GEOIP_DB=
MINISIEM_GEOIP_ASN_DB=
