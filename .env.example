# Copy to .env and change the values. Never commit .env.

# Any characters work, but avoid "$" (Docker Compose treats it as a variable) and quotes.
POSTGRES_PASSWORD=change-me-to-a-long-random-value

# Timezone of your syslog timestamps (they carry none), e.g. Europe/Rome.
MINISIEM_LOG_TZ=UTC

# Host port for the dashboard (http://127.0.0.1:<port>). Change it if 8000 is already in use
# or reserved by the OS (on Windows: "forbidden by its access permissions").
MINISIEM_PORT=8000

# Optional: if set, POST /ingest requires "Authorization: Bearer <token>".
MINISIEM_API_TOKEN=

# Optional: if set, the dashboard and GET /api/* ask for this token.
MINISIEM_READ_TOKEN=

# Optional: delete events and alerts older than this many days (0 keeps everything).
# The age is the time written in the log, not the time it was imported.
MINISIEM_RETENTION_DAYS=0
